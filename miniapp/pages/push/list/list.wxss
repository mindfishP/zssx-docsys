.page { padding: 16rpx 0 40rpx; }
.item { background: #fff; margin: 20rpx 24rpx; border-radius: 16rpx; padding: 28rpx; }
.item-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.preview {
  margin-top: 12rpx; color: #909399; font-size: 24rpx;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
