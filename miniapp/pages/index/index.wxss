.header { padding: 40rpx 32rpx 24rpx; }
.hello { font-size: 38rpx; font-weight: 600; }
.light { color: #909399; margin-top: 8rpx; }
.stats { display: flex; margin: 8rpx 24rpx 0; background: #fff; border-radius: 16rpx; padding: 28rpx 0; }
.stat { flex: 1; text-align: center; }
.num { font-size: 40rpx; font-weight: 700; color: #d4875a; }
.entries { display: flex; margin-top: 20rpx; }
.entry { flex: 1; text-align: center; }
.entry-icon {
  width: 88rpx; height: 88rpx; line-height: 88rpx; margin: 0 auto 12rpx;
  border-radius: 24rpx; background: #fdf3ec; color: #d4875a; font-size: 40rpx;
}
.entry-text { font-size: 24rpx; color: #606266; }
.recent { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-top: 1rpx solid #ebeef5; }
.recent-main { flex: 1; margin-right: 16rpx; }
.recent-title { font-size: 28rpx; margin-bottom: 6rpx; }
