<view class="page">
  <view class="header">
    <view class="hello">你好，<text class="hello-name">{{user.realName || user.username || '用户'}}</text></view>
    <view class="muted light">{{roleText}}<text wx:if="{{isAssoc}}"> · {{user.assocCode || '—'}}</text><text wx:if="{{levelText}}"> · {{levelText}}</text></view>
  </view>

  <view class="stats">
    <view class="stat" wx:for="{{statItems}}" wx:key="label">
      <view class="num">{{item.value}}</view>
      <view class="muted">{{item.label}}</view>
    </view>
  </view>

  <view class="card">
    <view class="title">快捷入口</view>
    <view class="entries">
      <view class="entry" wx:for="{{entries}}" wx:key="key" data-key="{{item.key}}" bindtap="onEntry">
        <view class="entry-icon">{{item.icon}}</view>
        <view class="entry-text">{{item.text}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view class="title">最近档案</view>
      <view class="muted" bindtap="goAll">全部 ›</view>
    </view>
    <view wx:if="{{recent.length === 0}}" class="empty">暂无档案</view>
    <view wx:for="{{recent}}" wx:key="bizId" class="recent" data-id="{{item.bizId}}" bindtap="openDetail">
      <view class="recent-main">
        <view class="recent-title">{{item.title}}</view>
        <view class="muted">{{item.assocCode}} · {{item.archiveYear}} 年 · {{item.majorCode}} 类</view>
      </view>
      <text class="tag {{item.statusCls}}">{{item.statusText}}</text>
    </view>
  </view>
</view>
