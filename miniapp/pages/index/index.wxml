<view class="card">
  <view class="hello">{{ user ? user.realName : '未登录' }}，欢迎</view>
  <view class="sub">一协一档 · 六大类档案线上填报</view>
</view>

<view class="card">
  <view class="section-title">快捷操作</view>
  <button class="btn-primary" bindtap="goFill">发起档案填报</button>
</view>

<view class="card">
  <view class="section-title">最近报送</view>
  <view wx:if="{{recent.length === 0}}" class="empty">暂无报送记录</view>
  <view wx:for="{{recent}}" wx:key="bizId" class="row">
    <text class="t">{{item.title}}</text>
    <text class="s">{{item.status === 0 ? '草稿' : item.status === 1 ? '待审核' : item.status === 2 ? '退回' : '已归档'}}</text>
  </view>
</view>
