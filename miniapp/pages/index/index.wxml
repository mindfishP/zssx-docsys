<view class="page">
  <view class="header">
    <view class="hello">你好，{{user.realName || user.username || '商协会管理员'}}</view>
    <view class="muted light">{{user.assocCode || '—'}} · {{levelText}}</view>
  </view>

  <view class="stats">
    <view class="stat">
      <view class="num">{{stats.archiveTotal || 0}}</view>
      <view class="muted">档案总数</view>
    </view>
    <view class="stat">
      <view class="num">{{pendingCount}}</view>
      <view class="muted">待审核</view>
    </view>
    <view class="stat">
      <view class="num">{{archivedCount}}</view>
      <view class="muted">已归档</view>
    </view>
  </view>

  <view class="card">
    <view class="title">快捷入口</view>
    <view class="entries">
      <view class="entry" bindtap="goFill">
        <view class="entry-icon">＋</view>
        <view class="entry-text">填报档案</view>
      </view>
      <view class="entry" bindtap="goPush">
        <view class="entry-icon">✉</view>
        <view class="entry-text">政策推送</view>
      </view>
      <view class="entry" bindtap="goBorrow">
        <view class="entry-icon">⇄</view>
        <view class="entry-text">档案借阅</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view class="title">最近档案</view>
      <view class="muted" bindtap="goArchive">全部 ›</view>
    </view>
    <view wx:if="{{recent.length === 0}}" class="empty">还没有档案，点“填报档案”开始</view>
    <view wx:for="{{recent}}" wx:key="bizId" class="recent" data-id="{{item.bizId}}" bindtap="openDetail">
      <view class="recent-main">
        <view class="recent-title">{{item.title}}</view>
        <view class="muted">{{item.archiveYear}} 年 · {{item.majorCode}} 类</view>
      </view>
      <text class="tag {{item.statusCls}}">{{item.statusText}}</text>
    </view>
  </view>
</view>
