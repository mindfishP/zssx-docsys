<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'available' ? 'active' : ''}}" data-tab="available" bindtap="onTab">可借阅档案</view>
    <view class="tab {{tab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="onTab">我的借阅</view>
  </view>

  <view wx:if="{{tab === 'available'}}">
    <view wx:if="{{available.length === 0 && !loading}}" class="empty">暂无可借阅档案</view>
    <view wx:for="{{available}}" wx:key="bizId" class="item">
      <view class="row">
        <view class="item-title">{{item.title}}</view>
        <text class="tag tag-success">公开</text>
      </view>
      <view class="muted">{{item.assocCode}} · {{item.archiveYear}} 年 · {{item.majorCode}} 类</view>
      <button class="btn small" data-id="{{item.bizId}}" data-title="{{item.title}}" bindtap="apply">申请借阅</button>
    </view>
  </view>

  <view wx:else>
    <view wx:if="{{records.length === 0 && !loading}}" class="empty">暂无借阅记录</view>
    <view wx:for="{{records}}" wx:key="borrowId" class="item">
      <view class="row">
        <view class="item-title">{{item.archiveId}}</view>
        <text class="tag {{item.statusCls}}">{{item.statusText}}</text>
      </view>
      <view class="muted">申请协会：{{item.applicantAssoc}}　应还：{{item.dueText}}</view>
      <view class="muted">事由：{{item.reason}}</view>
      <view wx:if="{{item.borrowStatus === 1}}" class="muted brand" data-id="{{item.bizId}}" bindtap="openArchive">查看档案内容 ›</view>
    </view>
  </view>
</view>
