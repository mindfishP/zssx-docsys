<view class="page">
  <view class="card">
    <view class="field"><text class="label">原密码</text><input class="input" password value="{{oldPassword}}" bindinput="onOld" /></view>
    <view class="field"><text class="label">新密码</text><input class="input" password value="{{newPassword}}" bindinput="onNew" /></view>
    <view class="field"><text class="label">确认新密码</text><input class="input" password value="{{confirm}}" bindinput="onConfirm" /></view>
    <button class="btn" style="margin-top:40rpx" loading="{{saving}}" bindtap="save">保存</button>
    <view class="tip">密码至少 6 位；修改后需重新登录</view>
  </view>
</view>
