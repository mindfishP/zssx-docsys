<view class="page">
  <view class="profile">
    <view class="avatar">{{initial}}</view>
    <view class="info">
      <view class="name">{{user.realName || user.username}}</view>
      <view class="muted">{{roleText}} · {{user.assocCode || '全局'}}</view>
    </view>
  </view>

  <view class="card list">
    <view class="cell" bindtap="editName">
      <text>修改姓名</text><text class="muted">{{user.realName || '—'}} ›</text>
    </view>
    <view class="cell" bindtap="changePassword">
      <text>修改密码</text><text class="muted">›</text>
    </view>
    <view class="cell" bindtap="about">
      <text>关于系统</text><text class="muted">v1.0 ›</text>
    </view>
  </view>

  <view class="card">
    <button class="btn btn-ghost" bindtap="logout">退出登录</button>
  </view>
</view>
