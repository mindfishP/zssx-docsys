.tabs { white-space: nowrap; background: #fff; padding: 12rpx 0; }
.tab { display: inline-block; padding: 12rpx 28rpx; margin-left: 12rpx; font-size: 26rpx; color: #606266; border-radius: 24rpx; }
.tab.active { background: #fdf3ec; color: #d4875a; font-weight: 600; }
.list { padding: 16rpx 0 40rpx; }
.item { background: #fff; margin: 20rpx 24rpx; border-radius: 16rpx; padding: 28rpx; }
.item-title { flex: 1; font-size: 30rpx; font-weight: 600; margin-right: 16rpx; }
.more { text-align: center; color: #909399; font-size: 24rpx; padding: 24rpx 0; }
