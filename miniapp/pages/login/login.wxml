<view class="page">
  <view class="center-box">
    <view class="hero">
      <view class="logo">档</view>
      <view class="name">商协会档案资料系统</view>
      <view class="sub">中山市商协会“一协一档”移动端</view>
    </view>

    <view class="form">
      <view class="field">
        <text class="label">账号</text>
        <input class="input" value="{{username}}" placeholder="请输入账号" bindinput="onUsername" />
      </view>
      <view class="field">
        <text class="label">密码</text>
        <input class="input" password value="{{password}}" placeholder="请输入密码" bindinput="onPassword" />
      </view>
      <button class="btn login-btn" loading="{{loading}}" bindtap="onLogin">登 录</button>
      <button class="btn btn-ghost wechat-btn" bindtap="onWechatLogin">微信一键登录</button>

      <view class="server-line" bindtap="editServer">服务器：{{baseUrl}}</view>
    </view>
  </view>
</view>
