<view class="page" wx:if="{{task}}">
  <view class="card">
    <view class="title">{{task.taskName}}</view>
    <view class="muted">任务编号：{{task.taskCode}}</view>
    <view class="muted">状态：{{task.status === 1 ? '进行中' : (task.status === 2 ? '已结束' : '已撤回')}}</view>
    <view class="muted">涉及大类：{{majorText}}</view>
    <view class="muted">目标范围：{{scopeText}}</view>
    <view class="muted">起止时间：{{rangeText}}</view>
  </view>
  <view class="card">
    <view class="title">任务说明</view>
    <view class="content">{{task.taskDesc || '（未填写任务说明）'}}</view>
  </view>
</view>
<view wx:else class="empty">加载中…</view>
