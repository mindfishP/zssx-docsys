.page { padding-bottom: 180rpx; }
.field { margin-bottom: 32rpx; }
.label { font-size: 26rpx; color: #606266; margin-bottom: 12rpx; }
.req { color: #f56c6c; margin-left: 4rpx; }
/* 输入框统一描边，便于识别可填写区域 */
.input-box {
  border: 2rpx solid #dcdfe6;
  border-radius: 12rpx;
  background: #fff;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  min-height: 44rpx;
  line-height: 44rpx;
  box-sizing: border-box;
}
.input-box:focus { border-color: #d4875a; }
.picker-box { display: flex; align-items: center; justify-content: space-between; }
.placeholder { color: #c0c4cc; }
.arrow { color: #c0c4cc; }
.radio-row { display: flex; gap: 40rpx; padding: 8rpx 0; }
.radio-item { display: flex; align-items: center; font-size: 28rpx; color: #303133; }
.attach-actions { display: flex; gap: 20rpx; }
.attach-btn {
  flex: 1; text-align: center; padding: 20rpx 0; border: 2rpx dashed #d4875a;
  color: #d4875a; border-radius: 12rpx; font-size: 26rpx;
}
.file-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 20rpx; margin-top: 16rpx; border: 2rpx solid #ebeef5; border-radius: 12rpx;
}
.file-name { flex: 1; font-size: 26rpx; margin-right: 16rpx; word-break: break-all; }
.file-del { color: #f56c6c; font-size: 26rpx; }
.footer {
  position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #ebeef5;
}
.footer .btn { flex: 1; }
.btn.ghost { background: #fff; color: #d4875a; border: 2rpx solid #d4875a; }
