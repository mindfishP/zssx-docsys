.section-title { font-weight: 700; margin-bottom: 16rpx; }
.files { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; }
.file { width: 160rpx; height: 160rpx; position: relative; }
.file image { width: 100%; height: 130rpx; border-radius: 8rpx; }
.file .del { display: block; text-align: center; font-size: 20rpx; color: #909399; }
.file.add { border: 2rpx dashed #c0c4cc; display: flex; align-items: center; justify-content: center;
  font-size: 60rpx; color: #c0c4cc; border-radius: 8rpx; }
.btns { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btns button { flex: 1; }
.ghost { background: #fff; color: #d4875a; border: 2rpx solid #d4875a; border-radius: 12rpx; }
