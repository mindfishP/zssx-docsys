# 复制为 .env（同目录，已被 .gitignore 忽略）后按本机情况填写；不要提交真实值
SERVER_PORT=8080

# 数据库
ZSSX_DB_URL=jdbc:mysql://localhost:3306/association_archive?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
ZSSX_DB_USERNAME=root
ZSSX_DB_PASSWORD=请填写数据库口令

# JWT HS256 密钥（Base64，长度 >= 32 字节）：openssl rand -base64 48
ZSSX_JWT_SECRET=请填写Base64密钥
ZSSX_JWT_EXPIRE_MINUTES=720

# 附件与存储
ZSSX_STORAGE_ROOT=D:/zssx-archive-files
ZSSX_URL_EXPIRE_MINUTES=30

# 微信小程序（接入真实登录时填写）
ZSSX_WECHAT_APPID=wx0000000000000000
ZSSX_WECHAT_SECRET=

# 跨域：允许访问的前端来源，多个用英文逗号分隔
ZSSX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173